# Enquiry form email delivery (Resend — https://resend.com)
#
# Without RESEND_API_KEY the site still works: the contact form validates,
# logs the enquiry to the server console, and asks the visitor to call or
# WhatsApp instead. Set these to turn on email delivery.

RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account.
ENQUIRY_FROM_EMAIL=enquiries@distinct-solutions.ae
# Where enquiries land.
ENQUIRY_TO_EMAIL=info@distinct-solutions.ae
